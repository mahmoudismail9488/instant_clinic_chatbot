# Copy to .env and fill in values. This file is safe to commit.
GROQ_API_KEY=
GROQ_AI_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com

# Local embedding model (via fastembed). Groq has no public embedding models.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Chunking — Config B selected from eval lab (see eval/outputs/LAB_REPORT.md)
# Compared on the same corpus: old=1200/200, cfgA=512/50, cfgB=1024/100
CHUNK_SIZE=1024
CHUNK_OVERLAP=100
ACTIVE_CHUNK_CONFIG=cfgB

# Retrieval
# DEFAULT_TOP_K=5

# HTTP API (frontend — Vite often uses :8080 or :5173)
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
# Production examples:
# CORS_ORIGINS=https://your-app.vercel.app
# CORS_ORIGIN_REGEX=https://.*\.vercel\.app
CORS_ORIGIN_REGEX=https?://(localhost|127\.0\.0\.1)(:\d+)?
